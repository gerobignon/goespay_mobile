{
  "expo": {
    "name": "GOESPAY",
    "slug": "goespay",
    "version": "1.2.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "goespay",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171e2b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.goespay.app",
      "buildNumber": "5",
      "infoPlist": {
        "NSCameraUsageDescription": "GOESPAY a besoin de la caméra pour vérifier votre identité (KYC).",
        "NSPhotoLibraryUsageDescription": "GOESPAY a besoin d'accéder à vos photos quand vous changez de photo de profil.",
        "NSFaceIDUsageDescription": "GOESPAY utilise Face ID pour déverrouiller l'application.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171e2b"
      },
      "edgeToEdgeEnabled": true,
      "package": "io.goespay.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "versionCode": 18
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#171e2b",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GOESPAY a besoin d'accéder à vos photos pour la vérification KYC.",
          "cameraPermission": "GOESPAY a besoin de la caméra pour vérifier votre identité (KYC)."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c08bc175-f5ea-4a10-9455-f6789a9a0348"
      }
    },
    "owner": "gerobignon"
  }
}
